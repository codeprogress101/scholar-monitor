// Included in the private synthetic environment by historical-multi-batch-uat.mjs.
async function appendAndCheck(c:any,item:any,input:any){
 const {admin,request,ok,m}=c;const [[identity]]:any=await admin.query('SELECT DATABASE() name');assert.match(identity.name,/^ldss_hmulti_test_\d+_[a-f\d]{8}$/);
 const path=`/api/v1/payout-cycles/${m.cycleId}/historical-append`,tests:any[]=[];
 const check=async(name:string,work:()=>Promise<void>)=>{await work();tests.push({name,passed:true});await save(folder+'/append-checks.json',{tests});};
 const preview=await ok(request('coordinator',path+'-preview?importId='+item.importId));assert.equal(preview.members.length,200);input={...input,expectedScopeHash:preview.scopeHash};
 const fail=async(body:any,status:number,code?:string,role='coordinator')=>{const r=await request(role,path,body);assert.equal(r.statusCode,status,r.body);if(code)assert.equal(r.json().error.code,code,r.body);};
 const firstSnapshot=async()=>{const out:any={};for(const [name,sql,args] of [
  ['root','SELECT * FROM historical_payout_setups WHERE batch_id=?',[m.batches[0].batchId]],
  ['frozen','SELECT * FROM ovr_finalizations WHERE batch_id=?',[m.batches[0].batchId]],
  ['allocations','SELECT * FROM payroll_allocations WHERE batch_id=? ORDER BY scholarship_id',[m.batches[0].batchId]],
  ['outcomes','SELECT * FROM payment_records WHERE batch_id=? ORDER BY scholarship_id',[m.batches[0].batchId]],
  ['publication','SELECT * FROM masterlist_publications WHERE masterlist_id=?',[m.batches[0].masterlistId]]
 ] as any[]){const [r]=await admin.execute(sql,args);out[name]=hash(JSON.stringify(r));}return out;};
 const original=await firstSnapshot();await save(folder+'/first-preservation-before.json',original);
 await check('Staff, pure Administrator and unassigned cannot append',async()=>{for(const role of ['staff','system_admin','unassigned'])await fail(input,403,undefined,role);});
 await check('Explicit default-off gate blocks append',async()=>{const [[actor]]:any=await admin.query("SELECT id FROM users WHERE email='coordinator@example.invalid'");const {HistoricalAppendService}=await import('../../../server/payouts/historical-append.js');const disabled=new HistoricalAppendService(new AuthorizationService(c.runtime));await assert.rejects(disabled.record(actor.id,m.cycleId,randomUUID(),input,randomUUID()),(e:any)=>e.code==='HISTORICAL_APPEND_DISABLED');});
 await check('Missing authority reference and reported release remain unresolved',async()=>{for(const field of ['reference','reportedReleaseOn','sourceLocation']){const p={...input};delete p[field];await fail(p,422,'VALIDATION_FAILED');}});
 await check('Future, reversed and overlapping historical dates rejected',async()=>{await fail({...input,deadlineOn:'2099-01-01'},422,'INVALID_HISTORICAL_DATE');await fail({...input,opensOn:input.deadlineOn,reportedReleaseOn:input.opensOn},422,'INVALID_HISTORICAL_DATE');const facts=await json(folder+'/historical-scenario-facts.json');await fail({...input,opensOn:facts.timeline[0].deadlineOn},422,'INVALID_HISTORICAL_DATE');});
 await check('Calendar, source hash and bound-root import conflicts rejected',async()=>{await fail({...input,expectedYearVersion:999},409,'VERSION_CONFLICT');await fail({...input,expectedScopeHash:'0'.repeat(64)},409,'SOURCE_CHANGED');await fail({...input,importId:m.batches[0].importId},409,'HISTORICAL_IMPORT_ALREADY_BOUND');});
 await check('Exact approved prior deadline is required',async()=>{await fail({...input,deadlineOn:m.day,reportedReleaseOn:m.day},409,'HISTORICAL_DEADLINE_MISMATCH');});
 await check('Audit failure rolls back entire additional setup',async()=>{
  const [[before]]:any=await admin.query('SELECT (SELECT COUNT(*) FROM historical_payout_setups) setups,(SELECT COUNT(*) FROM payroll_submission_windows) windows,(SELECT COUNT(*) FROM semester_entitlements) entitlements,(SELECT COUNT(*) FROM semester_submission_versions) deadlines');
  await admin.query("CREATE TRIGGER hmulti_fail_audit BEFORE INSERT ON audit_logs FOR EACH ROW BEGIN IF NEW.event_type='payroll.historical-append' THEN SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT='Synthetic audit rollback probe'; END IF; END");
  try{await fail(input,500);}finally{await admin.query('DROP TRIGGER hmulti_fail_audit');}
  const [[after]]:any=await admin.query('SELECT (SELECT COUNT(*) FROM historical_payout_setups) setups,(SELECT COUNT(*) FROM payroll_submission_windows) windows,(SELECT COUNT(*) FROM semester_entitlements) entitlements,(SELECT COUNT(*) FROM semester_submission_versions) deadlines');assert.deepEqual(after,before);
 });
 let result:any;const key=randomUUID();await check('Concurrent exact retries commit one Draft batch and no allocations',async()=>{const replies=await Promise.all([request('coordinator',path,input,key),request('coordinator',path,input,key)]);for(const r of replies)assert.equal(r.statusCode,200,r.body);assert.deepEqual(replies[0].json(),replies[1].json());result=replies[0].json();assert.equal(result.scholarCount,200);assert.equal(result.state,'draft');const [[counts]]:any=await admin.query('SELECT (SELECT COUNT(*) FROM historical_payout_setups) setups,(SELECT COUNT(*) FROM payroll_submission_windows) windows,(SELECT COUNT(*) FROM semester_entitlements) entitlements,(SELECT COUNT(*) FROM payment_records) payments');assert.equal(Number(counts.setups),2);assert.equal(Number(counts.windows),2);assert.equal(Number(counts.entitlements),800);assert.equal(Number(counts.payments),0);});
 await check('Lost-response retry returns the same result; changed payload conflicts',async()=>{assert.deepEqual(await ok(request('coordinator',path,input,key)),result);const changed=await request('coordinator',path,{...input,reason:'Different reviewed reason'},key);assert.equal(changed.statusCode,409);assert.equal(changed.json().error.code,'IDEMPOTENCY_CONFLICT');await fail(input,409,'VERSION_CONFLICT');});
 const batchId=result.batchId;await check('Batch list keeps original root and exposes both sources',async()=>{const view=await ok(request('coordinator',`/api/v1/payout-cycles/${m.cycleId}/submission-windows`));assert.equal(view.historical.batchId,m.batches[0].batchId);assert.equal(view.historicalBatches.length,2);assert.equal(view.historicalBatches[1].importId,item.importId);});
 await check('Full and paged candidates use exactly the second import',async()=>{const full=await ok(request('staff',`/api/v1/ovr-batches/${batchId}`));assert.equal(full.managed.form.rows.length,200);assert.deepEqual(full.managed.form.rows.map((r:any)=>r.scholarId).sort(),[...item.scholarIds].sort());const page=await ok(request('staff',`/api/v1/ovr-batches/${batchId}/candidates?offset=0&limit=25`));await save(folder+'/candidate-page-shape.json',page);assert.ok(JSON.stringify(page).includes(item.scholarIds[0])||JSON.stringify(page).includes('eligible'));});
 await check('Changed person source invalidates accepted approval and pinned batch',async()=>{const person=item.scholarIds[0];const [[v]]:any=await admin.execute('SELECT version FROM scholars WHERE id=?',[person]);try{await admin.execute('UPDATE scholars SET version=version+1 WHERE id=?',[person]);const detail=await ok(request('staff',`/api/v1/ovr-batches/${batchId}`));assert.equal(detail.managed.form.rows.length,199);assert.ok(JSON.stringify(detail.managed.items.find((r:any)=>r.scholarId===person)?.issues??detail.managed.items).includes('HISTORICAL_'));}finally{await admin.execute('UPDATE scholars SET version=? WHERE id=?',[v.version,person]);}const detail=await ok(request('staff',`/api/v1/ovr-batches/${batchId}`));assert.equal(detail.managed.form.rows.length,200);});
 await check('First root, frozen bytes, allocations, outcomes and publication unchanged',async()=>{assert.deepEqual(await firstSnapshot(),original);});
 await save(folder+'/append-checks.json',{at:new Date().toISOString(),tests,negativeSourceProbe:'Owned new synthetic person version only; restored in finally. No approvals/financial records inserted.',result});return batchId;
}
