{
  "name": "ldss-scholar-monitor",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.validation.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run check:secrets",
    "setup:local": "node scripts/setup-local.mjs",
    "test:db": "node scripts/check-database.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "account": "tsx scripts/account.ts",
    "test:auth-db": "tsx scripts/test-auth-db.ts",
    "roles": "tsx scripts/roles.ts",
    "test:rbac-db": "tsx scripts/test-rbac-db.ts",
    "test:configuration-db": "tsx scripts/test-configuration-db.ts",
    "test:academic-db": "tsx scripts/test-academic-db.ts",
    "test:status-db": "tsx scripts/test-status-db.ts",
    "test:qualification-db": "tsx scripts/test-qualification-db.ts",
    "test:scholars-db": "tsx scripts/test-scholars-db.ts",
    "test:academic-changes-db": "tsx scripts/test-academic-changes-db.ts",
    "test:masterlists-db": "tsx scripts/test-masterlists-db.ts",
    "test:masterlist-workflow-db": "tsx scripts/test-masterlist-workflow-db.ts",
    "test:masterlist-amendments-db": "tsx scripts/test-masterlist-amendments-db.ts",
    "test:requirements-db": "tsx scripts/test-requirements-db.ts",
    "test:requirement-instances-db": "tsx scripts/test-requirement-instances-db.ts",
    "test:requirement-receipts-db": "tsx scripts/test-requirement-receipts-db.ts",
    "test:requirement-workflow-db": "tsx scripts/test-requirement-workflow-db.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "lucide-react": "^1.48.0",
    "mysql2": "^3.24.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
