# npm run setup:local generates .env and a dedicated local database identity.
APP_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
APP_ORIGIN=http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ldss_scholar_monitor_dev
# DB_USER and DB_PASSWORD are generated by setup:local; do not commit .env.

# Server-enforced session limits; background identity checks do not renew idle expiry.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
